# Server runtime
PORT=4000
NODE_ENV=development

# Supabase/Postgres connection string.
# Use the Session Pooler connection string for a hosted Node service such as Render.
DATABASE_URL=

# Long random signing secret; generate a different value for production.
AUTH_SECRET=replace-with-a-long-random-string

# Exact browser/API origins. Do not add a trailing slash.
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:4000

# Supabase server connection.
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never be placed in frontend/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
STORAGE_BUCKET=nerdding-media

# OAuth note:
# Google/GitHub client IDs and client secrets are configured in
# Supabase Dashboard -> Authentication -> Providers, not in this file.
# Supabase sends the provider callback to:
# https://your-project.supabase.co/auth/v1/callback
# The application callback used by this backend is:
# http://localhost:4000/api/v1/auth/oauth/callback
